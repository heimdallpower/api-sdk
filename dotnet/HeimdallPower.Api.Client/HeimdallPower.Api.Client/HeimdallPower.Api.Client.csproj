<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Nullable>enable</Nullable>
        <PackageId>HeimdallPower.Api.Client</PackageId>
        <Version>0.0.0</Version> <!-- Placeholder, overridden in CI -->
        <Authors>Heimdall Power</Authors>
        <Company>Heimdall Power</Company>
        <Description>SDK for interacting with the Heimdall Power External API</Description>
        <RepositoryUrl>https://github.com/heimdallpower/api-sdk</RepositoryUrl>
        <PackageProjectUrl>https://developer.heimdallcloud.com</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
        <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
        <!-- Pin patched transitives of Microsoft.Identity.Web (via AspNetCore.DataProtection).
             10.0.10 is flagged by GHSA-c399-9853-6jmj, GHSA-7hqp-7c5m-4vq6, GHSA-r955-8q5j-3h83,
             GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7. Remove once Identity.Web resolves >= 10.0.13. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
        <_Parameter1>HeimdallPower.Api.Client.UnitTests</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>

</Project>
